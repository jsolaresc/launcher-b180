<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LauncherTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="DockButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/bg_dock_button</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
    </style>
</resources>

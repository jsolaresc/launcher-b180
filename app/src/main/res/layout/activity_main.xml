<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal: 1024x600 px a 240 dpi = 682x400 dp. Mapa 70% / columna 30% / dock abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <!-- MAPA (etapa 3). Por ahora, acceso a Google Maps. -->
        <LinearLayout
            android:id="@+id/map_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:background="@drawable/bg_map"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_map_pin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/map_placeholder_title"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/map_placeholder_body"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- COLUMNA DERECHA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <!-- MÚSICA -->
            <LinearLayout
                android:id="@+id/music_card"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:id="@+id/music_source"
                        android:text="@string/music_source"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_cover">

                        <ImageView
                            android:id="@+id/cover"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_note" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/track_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/music_title"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/track_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/music_hint"
                            android:textColor="@color/muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_prev"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_round_button"
                        android:contentDescription="@string/prev"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_prev" />

                    <ImageButton
                        android:id="@+id/btn_play"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_play"
                        android:contentDescription="@string/play_pause"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btn_next"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_round_button"
                        android:contentDescription="@string/next"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next" />
                </LinearLayout>

                <!-- VOLUMEN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/vol_down"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_round_button"
                        android:contentDescription="@string/vol_down"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vol_low" />

                    <SeekBar
                        android:id="@+id/volume"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/volume"
                        android:progressBackgroundTint="@color/track"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/text" />

                    <ImageButton
                        android:id="@+id/vol_up"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_round_button"
                        android:contentDescription="@string/vol_up"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_vol_high" />
                </LinearLayout>
            </LinearLayout>

            <!-- HORA -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- DOCK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/dock_apps"
            style="@style/DockButton"
            android:contentDescription="@string/label_apps"
            android:src="@drawable/ic_apps" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/dock_maps"
            style="@style/DockButton"
            android:background="@drawable/bg_dock_active"
            android:contentDescription="@string/label_maps"
            android:src="@drawable/ic_maps" />

        <ImageButton
            android:id="@+id/dock_music"
            style="@style/DockButton"
            android:contentDescription="@string/label_music"
            android:src="@drawable/ic_music" />

        <ImageButton
            android:id="@+id/dock_phone"
            style="@style/DockButton"
            android:contentDescription="@string/label_phone"
            android:src="@drawable/ic_phone" />

        <ImageButton
            android:id="@+id/dock_radio"
            style="@style/DockButton"
            android:contentDescription="@string/label_radio"
            android:src="@drawable/ic_radio" />

        <ImageButton
            android:id="@+id/dock_settings"
            style="@style/DockButton"
            android:contentDescription="@string/label_settings"
            android:src="@drawable/ic_settings" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/dock_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>

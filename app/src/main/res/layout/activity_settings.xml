<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/settings_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Columna izquierda -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Tema -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:text="@string/theme" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/theme_light"
                        style="@style/SettingsOption"
                        android:text="@string/theme_light" />

                    <TextView
                        android:id="@+id/theme_dark"
                        style="@style/SettingsOption"
                        android:layout_marginStart="5dp"
                        android:text="@string/theme_dark" />

                    <TextView
                        android:id="@+id/theme_auto"
                        style="@style/SettingsOption"
                        android:layout_marginStart="5dp"
                        android:text="@string/theme_auto" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/theme_auto_hint"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Tarjeta inferior -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:text="@string/bottom_card" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="37dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/card_places"
                        style="@style/SettingsOption"
                        android:text="@string/card_places" />

                    <TextView
                        android:id="@+id/card_clock"
                        style="@style/SettingsOption"
                        android:layout_marginStart="5dp"
                        android:text="@string/card_clock" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="37dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/card_compass"
                        style="@style/SettingsOption"
                        android:text="@string/card_compass" />

                    <TextView
                        android:id="@+id/card_speedo"
                        style="@style/SettingsOption"
                        android:layout_marginStart="5dp"
                        android:text="@string/card_speedo" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Columna derecha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Volumen -->
            <LinearLayout
                android:id="@+id/volumes"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingTop="11dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:text="@string/volume_title" />
            </LinearLayout>

            <!-- Mapa sin conexión -->
            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="11dp">

                <TextView
                    style="@style/SettingsTitle"
                    android:text="@string/offline_map" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/offline_map_hint"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/offline_button"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_button_accent_round"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/offline_download"
                        android:textColor="@color/on_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/offline_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/offline_progress"
                    style="@android:style/Widget.Material.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:progressBackgroundTint="@color/track"
                    android:progressTint="@color/accent"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
